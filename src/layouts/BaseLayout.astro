---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import FlyoutPanel from '../components/FlyoutPanel.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Your intelligent data exploration companion - articles, tools, and resources for Microsoft Fabric Data Agent.', ogImage } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '';
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || 'https://cloud.umami.is/script.js';
const canonicalUrl = new URL(Astro.url.pathname, 'https://fabricdataagent.com').toString();
const ogImageUrl = ogImage || `${base}data-agent-logo.png`;
---

<!doctype html>
<html lang="en" class="dark" style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function() {
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch(e) {}
        var el = document.documentElement;
        if (theme === 'dark') {
          el.classList.add('dark');
          el.style.colorScheme = 'dark';
        } else {
          el.classList.remove('dark');
          el.style.colorScheme = 'light';
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cloud.umami.is https://d3js.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.youtube.com https://www.linkedin.com; connect-src 'self' https://cloud.umami.is https://api-gateway.umami.dev;" />
    <link rel="icon" type="image/png" href={`${base}data-agent-logo.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM-friendly site content" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Fabric Data Agent" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
    {umamiId && <script defer src={umamiSrc} data-website-id={umamiId} data-host-url="https://cloud.umami.is"></script>}
  </head>
  <body class="min-h-screen bg-gray-50 font-sans text-gray-900 antialiased dark:bg-darker dark:text-light">
    <!-- Dot grid background pattern -->
    <div class="dot-pattern fixed inset-0 -z-10"></div>

    <Sidebar />

    <div id="main-wrapper" class="min-h-screen transition-[margin] duration-300 lg:ml-[260px]">
      <TopBar />

      <main aria-label="Main content" data-pagefind-body>
        <slot />
      </main>

      <Footer />
    </div>

    <FlyoutPanel />

    <script is:inline>
      // Bookmark functions
      function getBookmarks() {
        try {
          return JSON.parse(localStorage.getItem('fda-bookmarks') || '[]');
        } catch { return []; }
      }

      function saveBookmarks(bookmarks) {
        localStorage.setItem('fda-bookmarks', JSON.stringify(bookmarks));
      }

      function isBookmarked(id) {
        return getBookmarks().some(function(b) { return b.id === id; });
      }

      function toggleBookmark(btn) {
        var id = btn.dataset.bookmarkId;
        var bookmarks = getBookmarks();
        var existing = bookmarks.findIndex(function(b) { return b.id === id; });

        if (existing >= 0) {
          bookmarks.splice(existing, 1);
          if (typeof umami !== 'undefined') umami.track('bookmark-remove', { title: btn.dataset.bookmarkTitle, type: btn.dataset.bookmarkType });
        } else {
          bookmarks.push({
            id: id,
            title: btn.dataset.bookmarkTitle,
            url: btn.dataset.bookmarkUrl,
            type: btn.dataset.bookmarkType,
            savedAt: new Date().toISOString(),
          });
          if (typeof umami !== 'undefined') umami.track('bookmark-add', { title: btn.dataset.bookmarkTitle, type: btn.dataset.bookmarkType });
        }

        saveBookmarks(bookmarks);
        updateBookmarkUI(btn, existing < 0);
      }

      function updateBookmarkUI(btn, isActive) {
        var outline = btn.querySelector('.bookmark-icon-outline');
        var filled = btn.querySelector('.bookmark-icon-filled');
        if (isActive) {
          outline.classList.add('hidden');
          filled.classList.remove('hidden');
          btn.classList.add('text-accent');
          btn.classList.remove('text-gray-300', 'dark:text-muted/40');
        } else {
          outline.classList.remove('hidden');
          filled.classList.add('hidden');
          btn.classList.remove('text-accent');
          btn.classList.add('text-gray-300', 'dark:text-muted/40');
        }
      }

      function initBookmarks() {
        document.querySelectorAll('.bookmark-btn').forEach(function(btn) {
          var id = btn.dataset.bookmarkId;
          updateBookmarkUI(btn, isBookmarked(id));
        });
      }

      window.toggleBookmark = toggleBookmark;

      document.addEventListener('DOMContentLoaded', initBookmarks);
      document.addEventListener('astro:after-swap', initBookmarks);
    </script>

    <script is:inline define:vars={{ base }}>
      window.__BASE_URL__ = base;
    </script>

    <script is:inline>
      // Scroll-triggered fade-in animations
      function initScrollAnimations() {
        var elements = document.querySelectorAll('.animate-on-scroll');
        if (!elements.length) return;

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        elements.forEach(function(el) { observer.observe(el); });
      }

      document.addEventListener('DOMContentLoaded', initScrollAnimations);
      document.addEventListener('astro:after-swap', initScrollAnimations);
    </script>

    <style is:global>
      .dot-pattern {
        background-image: radial-gradient(circle, rgba(45, 43, 127, 0.08) 1px, transparent 1px);
        background-size: 24px 24px;
      }
      .dark .dot-pattern {
        background-image: radial-gradient(circle, rgba(45, 43, 127, 0.3) 1px, transparent 1px);
      }
    </style>
  </body>
</html>
