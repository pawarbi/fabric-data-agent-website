---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/articles/', label: 'Articles' },
  { href: '/resources/', label: 'Resources' },
  { href: '/videos/', label: 'Videos' },
  { href: '/events/', label: 'Events' },
  { href: '/tools/', label: 'Tools' },
  { href: '/about/', label: 'About' },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href);
}
---

<nav aria-label="Main navigation" class="fixed top-0 left-0 right-0 z-50 border-b border-indigo/20 bg-dark/80 backdrop-blur-xl shadow-[0_1px_12px_rgba(0,212,170,0.06)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-lg font-bold text-light transition-colors hover:text-teal">
        <span class="text-teal">⚡</span>
        <span>Fabric Data Agent</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden items-center gap-1 md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-all duration-300',
              isActive(link.href)
                ? 'bg-teal/10 text-teal'
                : 'text-muted hover:bg-indigo/10 hover:text-light',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href="/search/"
          class="ml-2 rounded-lg p-2 text-muted transition-all duration-300 hover:bg-indigo/10 hover:text-teal"
          aria-label="Search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="rounded-lg p-2 text-muted transition-colors hover:text-light md:hidden"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-indigo/20 bg-dark/95 backdrop-blur-xl md:hidden">
    <div class="space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block rounded-lg px-3 py-2 text-sm font-medium transition-all duration-300',
            isActive(link.href)
              ? 'bg-teal/10 text-teal'
              : 'text-muted hover:bg-indigo/10 hover:text-light',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/search/"
        class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-muted transition-all duration-300 hover:bg-indigo/10 hover:text-light"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Search
      </a>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
