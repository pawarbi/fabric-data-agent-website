---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface NavItem {
  href: string;
  label: string;
  icon: string;
  external?: boolean;
}

interface NavGroup {
  heading: string;
  emoji: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    heading: 'Discover',
    emoji: '📚',
    items: [
      { href: `${base}articles/`, label: 'Articles', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
      { href: `${base}videos/`, label: 'Videos', icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
      { href: `${base}linkedin/`, label: 'LinkedIn', icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z' },
      { href: `${base}explore/`, label: 'Explore', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7' },
    ],
  },
  {
    heading: 'Resources',
    emoji: '🔗',
    items: [
      { href: `${base}resources/`, label: 'Resources', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
      { href: `${base}tools/`, label: 'Tools', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
    ],
  },
  {
    heading: 'Learn',
    emoji: '🎓',
    items: [
      { href: `${base}learn/`, label: 'Learning Paths', icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222' },
      { href: `${base}saved/`, label: 'Saved', icon: 'M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z' },
    ],
  },
  {
    heading: 'Community',
    emoji: '📅',
    items: [
      { href: `${base}contribute/`, label: 'Contribute', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
      { href: `${base}contributors/`, label: 'Contributors', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
      { href: `${base}events/`, label: 'Events', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
      { href: 'https://community.fabric.microsoft.com/t5/Fabric-Ideas/idb-p/fbc_ideas', label: 'Submit an Idea', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z', external: true },
      { href: 'https://roadmap.fabric.microsoft.com/?product=datascience', label: 'Public Roadmap', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7', external: true },
      { href: `${base}about/`, label: 'About', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
    ],
  },
];

function isActive(href: string): boolean {
  if (href === base) return currentPath === base || currentPath === base.replace(/\/$/, '');
  return currentPath === href || currentPath.startsWith(href);
}
---

<!-- Mobile backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden"
  aria-hidden="true"
></div>

<!-- Sidebar -->
<aside
  id="sidebar"
  class="fixed top-0 left-0 z-50 flex h-screen w-[260px] flex-col border-r border-gray-200 bg-gray-50 transition-transform duration-300 -translate-x-full dark:border-indigo/20 dark:bg-darker lg:translate-x-0"
  aria-label="Site navigation"
  data-pagefind-ignore
>
  <!-- Logo -->
  <div class="flex h-[60px] items-center gap-2 border-b border-gray-200 px-5 dark:border-indigo/20">
    <a href={base} class="flex items-center gap-2 text-lg font-bold text-gray-900 transition-colors hover:text-teal dark:text-light">
      <span class="text-teal text-xl">⚡</span>
      <span class="sidebar-label">Fabric Data Agent</span>
    </a>
  </div>

  <!-- Nav groups -->
  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-5">
    {navGroups.map((group) => (
      <div>
        <h3 class="sidebar-label mb-1 flex items-center gap-1.5 px-3 text-[11px] font-semibold uppercase tracking-wider text-gray-400 dark:text-muted/70">
          <span>{group.emoji}</span>
          <span>{group.heading}</span>
        </h3>
        <ul class="space-y-0.5">
          {group.items.map((item) => (
            <li>
              <a
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class:list={[
                  'sidebar-link group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-all duration-200',
                  !item.external && isActive(item.href)
                    ? 'border-l-2 border-teal bg-teal/10 text-teal'
                    : 'border-l-2 border-transparent text-gray-500 hover:bg-gray-200 hover:text-gray-900 dark:text-muted dark:hover:bg-indigo/10 dark:hover:text-light',
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-[18px] w-[18px] flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
                <span class="sidebar-label">{item.label}</span>
                {item.external && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 flex-shrink-0 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Collapse toggle (desktop) -->
  <div class="hidden border-t border-gray-200 p-3 dark:border-indigo/20 lg:block">
    <button
      id="sidebar-collapse-btn"
      class="flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-500 transition-colors hover:bg-gray-200 hover:text-gray-900 dark:text-muted dark:hover:bg-indigo/10 dark:hover:text-light"
      aria-label="Toggle sidebar"
    >
      <svg id="collapse-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
      </svg>
      <span class="sidebar-label">Collapse</span>
    </button>
  </div>
</aside>

<script>
  function initSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const collapseBtn = document.getElementById('sidebar-collapse-btn');
    const mainWrapper = document.getElementById('main-wrapper');
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const collapseIcon = document.getElementById('collapse-icon');

    if (!sidebar || !backdrop) return;

    let isMobileOpen = false;
    let isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';

    // Apply initial collapsed state on desktop
    if (isCollapsed) applyCollapsed(true);

    function openMobile() {
      isMobileOpen = true;
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }

    function closeMobile() {
      isMobileOpen = false;
      sidebar.classList.add('-translate-x-full');
      sidebar.classList.remove('translate-x-0');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
    }

    function applyCollapsed(collapsed: boolean) {
      const labels = sidebar!.querySelectorAll('.sidebar-label');
      if (collapsed) {
        sidebar!.classList.add('sidebar-collapsed');
        sidebar!.style.width = '68px';
        mainWrapper?.classList.remove('lg:ml-[260px]');
        mainWrapper?.classList.add('lg:ml-[68px]');
        labels.forEach((el) => el.classList.add('hidden'));
        if (collapseIcon) {
          collapseIcon.style.transform = 'rotate(180deg)';
        }
      } else {
        sidebar!.classList.remove('sidebar-collapsed');
        sidebar!.style.width = '260px';
        mainWrapper?.classList.remove('lg:ml-[68px]');
        mainWrapper?.classList.add('lg:ml-[260px]');
        labels.forEach((el) => el.classList.remove('hidden'));
        if (collapseIcon) {
          collapseIcon.style.transform = '';
        }
      }
    }

    // Hamburger button
    hamburgerBtn?.addEventListener('click', () => {
      if (window.innerWidth < 1024) {
        isMobileOpen ? closeMobile() : openMobile();
      } else {
        // On desktop hamburger (when collapsed), expand sidebar
        isCollapsed = false;
        localStorage.setItem('sidebar-collapsed', 'false');
        applyCollapsed(false);
      }
    });

    // Backdrop click closes mobile sidebar
    backdrop.addEventListener('click', closeMobile);

    // Collapse toggle
    collapseBtn?.addEventListener('click', () => {
      isCollapsed = !isCollapsed;
      localStorage.setItem('sidebar-collapsed', String(isCollapsed));
      applyCollapsed(isCollapsed);
    });

    // Close mobile sidebar on nav link click
    sidebar.querySelectorAll('.sidebar-link').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024 && isMobileOpen) {
          closeMobile();
        }
      });
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMobileOpen) closeMobile();
    });
  }

  // Run on initial load and on Astro page transitions
  initSidebar();
  document.addEventListener('astro:after-swap', initSidebar);
</script>
