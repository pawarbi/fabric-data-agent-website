---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const [articles, resources, videos, events, tools, linkedin] = await Promise.all([
  getCollection('articles'),
  getCollection('resources'),
  getCollection('videos'),
  getCollection('events'),
  getCollection('tools'),
  getCollection('linkedin'),
]);

const allContent = [...articles, ...resources, ...videos, ...events, ...tools, ...linkedin];

const contributorCounts = new Map<string, number>();
allContent.forEach(item => {
  const name = item.data.contributor;
  contributorCounts.set(name, (contributorCounts.get(name) || 0) + 1);
});

const sortedContributors = [...contributorCounts.entries()].sort((a, b) => b[1] - a[1]);

const getBadge = (count: number) => {
  if (count >= 10) return '🥇';
  if (count >= 4) return '🥈';
  return '🥉';
};

const getInitials = (name: string) => {
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  return name.slice(0, 2).toUpperCase();
};
---

<BaseLayout title="Contributors | Fabric Data Agent" description="Meet the community contributors behind Fabric Data Agent">
  <PageHeader
    title="Contributors"
    description={`${sortedContributors.length} community members contributing to the knowledge base`}
  />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {sortedContributors.map(([name, count]) => (
        <a
          href={`/contributors/${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`}
          class="group flex flex-col items-center gap-3 rounded-xl border border-gray-200 bg-white p-6 text-center backdrop-blur-sm transition-all duration-300 hover:border-teal/30 hover:shadow-[0_0_20px_rgba(0,212,170,0.15)] hover:scale-[1.02] dark:border-indigo/20 dark:bg-dark/60"
        >
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-teal/10 text-lg font-bold text-teal transition-colors group-hover:bg-teal/20">
            {getInitials(name)}
          </div>
          <h3 class="text-base font-semibold text-gray-900 transition-colors group-hover:text-teal dark:text-light">
            {name}
          </h3>
          <p class="text-sm text-gray-500 dark:text-muted">
            {getBadge(count)} {count} contribution{count !== 1 ? 's' : ''}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
