---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Search | Fabric Data Agent">
  <PageHeader
    title="Search"
    description="Find articles, resources, videos, events, and tools"
  />

  <section class="mx-auto max-w-4xl px-6 pb-20">
    <link href={`${base}pagefind/pagefind-ui.css`} rel="stylesheet">
    <div id="search"></div>
    <div id="search-loading" class="text-center py-12">
      <p class="text-gray-500 dark:text-muted">Loading search...</p>
    </div>
    <div id="search-error" class="hidden text-center py-12">
      <p class="text-gray-500 dark:text-muted text-lg">Search is available after building the site.</p>
      <p class="mt-2 text-sm text-gray-400 dark:text-muted/60">Run <code class="rounded bg-gray-100 dark:bg-indigo/20 px-2 py-0.5">npm run build</code> first, then <code class="rounded bg-gray-100 dark:bg-indigo/20 px-2 py-0.5">npm run preview</code> to test search locally.</p>
    </div>
    <script is:inline>
      (function loadSearch() {
        var script = document.createElement('script');
        script.src = (window.__BASE_URL__ || '/') + 'pagefind/pagefind-ui.js';
        script.onload = function() {
          var loadingEl = document.getElementById('search-loading');
          if (loadingEl) loadingEl.classList.add('hidden');
          
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            showImages: false,
            showFilters: true,
          });

          // Track search queries
          var searchInput = document.querySelector('.pagefind-ui__search-input');
          if (searchInput) {
            var searchTimeout;
            searchInput.addEventListener('input', function(e) {
              clearTimeout(searchTimeout);
              var val = e.target.value;
              if (val && val.length >= 3) {
                searchTimeout = setTimeout(function() {
                  if (typeof umami !== 'undefined') umami.track('search', { query: val });
                }, 1000);
              }
            });
          }

          var urlParams = new URLSearchParams(window.location.search);
          var query = urlParams.get('q');
          if (query) {
            setTimeout(function() {
              var input = document.querySelector('.pagefind-ui__search-input');
              if (input) {
                input.value = query;
                input.dispatchEvent(new Event('input', { bubbles: true }));
              }
            }, 100);
          }
        };
        script.onerror = function() {
          var loadingEl = document.getElementById('search-loading');
          var errorEl = document.getElementById('search-error');
          if (loadingEl) loadingEl.classList.add('hidden');
          if (errorEl) errorEl.classList.remove('hidden');
        };
        document.head.appendChild(script);
      })();
    </script>
  </section>
</BaseLayout>

<style is:global>
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #00D4AA;
    --pagefind-ui-text: #1f2937;
    --pagefind-ui-background: #f9fafb;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 16 / 9;
    --pagefind-ui-font: 'Inter', sans-serif;
  }

  .dark {
    --pagefind-ui-text: #E8E8F0;
    --pagefind-ui-background: #0A0A1A;
    --pagefind-ui-border: #2D2B7F;
    --pagefind-ui-tag: #1B1A55;
  }

  .pagefind-ui__search-input {
    background-color: #f3f4f6 !important;
    color: #1f2937 !important;
    border-color: #e5e7eb !important;
  }
  .dark .pagefind-ui__search-input {
    background-color: #1B1A55 !important;
    color: #E8E8F0 !important;
    border-color: #2D2B7F !important;
  }

  .pagefind-ui__search-input::placeholder {
    color: #9ca3af !important;
  }
  .dark .pagefind-ui__search-input::placeholder {
    color: #8888AA !important;
  }

  .pagefind-ui__result {
    background-color: #ffffff !important;
    border-color: #e5e7eb !important;
    padding: 1rem !important;
    border-radius: 8px !important;
  }
  .dark .pagefind-ui__result {
    background-color: #12123A !important;
    border-color: #2D2B7F !important;
  }

  .pagefind-ui__result-link {
    color: #00D4AA !important;
  }

  .pagefind-ui__result-excerpt {
    color: #4b5563 !important;
  }
  .dark .pagefind-ui__result-excerpt {
    color: #C0C0D0 !important;
  }

  mark.pagefind-ui__result-highlight {
    background-color: rgba(0, 212, 170, 0.15) !important;
    color: #00A88A !important;
  }
  .dark mark.pagefind-ui__result-highlight {
    background-color: rgba(0, 212, 170, 0.2) !important;
    color: #00D4AA !important;
  }

  .pagefind-ui__message {
    color: #1f2937 !important;
  }
  .dark .pagefind-ui__message {
    color: #E8E8F0 !important;
  }

  .pagefind-ui__button {
    background-color: #f3f4f6 !important;
    color: #1f2937 !important;
    border-color: #e5e7eb !important;
  }
  .dark .pagefind-ui__button {
    background-color: #1B1A55 !important;
    color: #E8E8F0 !important;
    border-color: #2D2B7F !important;
  }

  .pagefind-ui__button:hover {
    border-color: #00D4AA !important;
  }
</style>
