---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentCard from '../../components/ContentCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import JsonLd from '../../components/JsonLd.astro';

const tools = await getCollection('tools');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allTags = [...new Set(tools.flatMap((t) => t.data.tags))].sort();
---

<BaseLayout title="Tools | Fabric Data Agent" description="Useful tools and utilities for working with Microsoft Fabric Data Agents">
	<JsonLd
		type="CollectionPage"
		title="Tools | Fabric Data Agent"
		description="Useful tools and utilities for working with Microsoft Fabric Data Agents"
		url="/tools"
	/>
	<PageHeader
		title="Tools"
		description="Useful tools and utilities for working with Microsoft Fabric Data Agents"
	/>
	<section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
		<div class="flex flex-wrap items-start justify-between gap-4 mb-2">
			<div class="flex-1 min-w-0">{allTags.length > 0 && <TagFilter tags={allTags} />}</div>
			<ViewToggle gridId="tools-grid" listId="tools-list" />
		</div>
		{tools.length > 0 ? (
			<div id="tools-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{tools.map((tool) => (
					<div class="relative" data-tags={tool.data.tags.join(',')}>
						<span class="absolute right-3 top-3 z-10 rounded-full bg-gray-100 text-gray-500 dark:bg-muted/60 px-2 py-0.5 text-xs dark:text-muted backdrop-blur">
							{tool.data.category}
						</span>
						<ContentCard
							title={tool.data.title}
							description={tool.data.description}
							url={tool.data.url}
							tags={tool.data.tags}
							author={tool.data.author}
							type="tool"
						/>
					</div>
				))}
			</div>

			<div id="tools-list" class="hidden space-y-1">
				{tools.map((tool) => (
					<div
						class="group flex items-center gap-3 rounded-lg px-3 py-2 transition-colors hover:bg-teal/5 dark:hover:bg-teal/10 cursor-pointer"
						data-tags={tool.data.tags.join(',')}
						data-flyout
						data-flyout-title={tool.data.title}
						data-flyout-description={tool.data.description}
						data-flyout-url={tool.data.url}
						data-flyout-type="tool"
						data-flyout-author={tool.data.author || ''}
					>
						<span class="text-sm font-medium text-gray-900 dark:text-light group-hover:text-teal transition-colors truncate">
							{tool.data.title}
						</span>
						<span class="text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap shrink-0">
							{tool.data.category}
						</span>
						{tool.data.author && (
							<span class="ml-auto text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap shrink-0">
								{tool.data.author}
							</span>
						)}
					</div>
				))}
			</div>
		) : (
			<div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-16 text-center">
				<p class="text-lg text-gray-500 dark:text-muted">No tools available yet. Check back soon!</p>
				<p class="mt-2 text-sm text-gray-400 dark:text-muted/60">Built something cool? <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 hover:text-tealDark">Contribute</a></p>
			</div>
		)}
	</section>
</BaseLayout>
