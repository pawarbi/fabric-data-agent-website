---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagFilter from '../../components/TagFilter.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import ContentCard from '../../components/ContentCard.astro';
import JsonLd from '../../components/JsonLd.astro';

const allResources = await getCollection('resources');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allTags = [...new Set(allResources.flatMap((r) => r.data.tags))];
---

<BaseLayout title="Resources | Fabric Data Agent" description="Curated links, documentation, and learning materials for Fabric Data Agents">
  <JsonLd
    type="CollectionPage"
    title="Resources"
    description="Curated links, documentation, and learning materials for Fabric Data Agents"
    url={Astro.url.toString()}
  />

  <PageHeader
    title="Resources"
    description="Curated links, documentation, and learning materials for Fabric Data Agents"
  />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    {allResources.length > 0 ? (
      <>
        <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
          <div class="flex-1 min-w-0"><TagFilter tags={allTags} /></div>
          <ViewToggle gridId="resources-grid" listId="resources-list" />
        </div>
        <div id="resources-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {allResources.map((resource) => (
            <div data-tags={resource.data.tags.join(',')}>
              <ContentCard
                title={resource.data.title}
                description={resource.data.description}
                url={resource.data.url}
                tags={resource.data.tags}
                author={resource.data.author}
                type="resource"
              />
            </div>
          ))}
        </div>

        <div id="resources-list" class="hidden space-y-1">
          {allResources.map((resource) => (
            <div
              class="group flex items-center gap-3 rounded-lg px-3 py-2 transition-colors hover:bg-teal/5 dark:hover:bg-teal/10 cursor-pointer"
              data-tags={resource.data.tags.join(',')}
              data-flyout
              data-flyout-title={resource.data.title}
              data-flyout-description={resource.data.description}
              data-flyout-url={resource.data.url}
              data-flyout-type="resource"
              data-flyout-author={resource.data.author || ''}
            >
              <span class="text-sm font-medium text-gray-900 dark:text-light group-hover:text-teal transition-colors truncate">
                {resource.data.title}
              </span>
              {resource.data.author && (
                <span class="ml-auto text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap shrink-0">
                  {resource.data.author}
                </span>
              )}
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-16 text-center">
        <p class="text-lg text-gray-500 dark:text-muted">No resources available yet. Check back soon!</p>
        <p class="mt-2 text-sm text-gray-400 dark:text-muted/60">Know a useful resource? <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 hover:text-tealDark">Contribute</a></p>
      </div>
    )}
  </section>
</BaseLayout>
