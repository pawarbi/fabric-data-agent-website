---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TagFilter from '../../components/TagFilter.astro';
import ContentCard from '../../components/ContentCard.astro';
import JsonLd from '../../components/JsonLd.astro';

const allResources = await getCollection('resources');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allTags = [...new Set(allResources.flatMap((r) => r.data.tags))];
---

<BaseLayout title="Resources | Fabric Data Agent" description="Curated links, documentation, and learning materials for Fabric Data Agents">
  <JsonLd
    type="CollectionPage"
    title="Resources"
    description="Curated links, documentation, and learning materials for Fabric Data Agents"
    url={Astro.url.toString()}
  />

  <PageHeader
    title="Resources"
    description="Curated links, documentation, and learning materials for Fabric Data Agents"
  />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    {allResources.length > 0 ? (
      <>
        <TagFilter tags={allTags} />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {allResources.map((resource) => (
            <ContentCard
              title={resource.data.title}
              description={resource.data.description}
              url={resource.data.url}
              tags={resource.data.tags}
              author={resource.data.author}
              type="resource"
            />
          ))}
        </div>
      </>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-16 text-center">
        <p class="text-lg text-gray-500 dark:text-muted">No resources available yet. Check back soon!</p>
        <p class="mt-2 text-sm text-gray-400 dark:text-muted/60">Know a useful resource? <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 hover:text-tealDark">Contribute</a></p>
      </div>
    )}
  </section>
</BaseLayout>
