---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentCard from '../../components/ContentCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import SortDropdown from '../../components/SortDropdown.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

articles.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const allTags = [...new Set(articles.flatMap((a) => a.data.tags))].sort();
---

<BaseLayout title="Articles | Fabric Data Agent" description="Curated articles about Microsoft Fabric Data Agents, handpicked by the community">
  <JsonLd
    type="CollectionPage"
    title="Articles"
    description="Curated articles about Microsoft Fabric Data Agents, handpicked by the community"
    url={Astro.url.toString()}
  />

  <PageHeader
    title="Articles"
    description="Curated articles about Microsoft Fabric Data Agents, handpicked by the community"
  />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
      <div class="flex-1 min-w-0"><TagFilter tags={allTags} /></div>
      <div class="flex items-center gap-3">
        <SortDropdown
          options={[
            { value: 'published', label: 'Published Date' },
            { value: 'submitted', label: 'Submitted Date' },
          ]}
          defaultValue="published"
        />
        <ViewToggle gridId="articles-grid" listId="articles-list" />
      </div>
    </div>

    {articles.length > 0 ? (
      <div id="articles-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <div
            data-sort-publish={new Date(article.data.publishDate).getTime()}
            data-sort-submitted={article.data.submittedDate ? new Date(article.data.submittedDate).getTime() : new Date(article.data.publishDate).getTime()}
            data-tags={article.data.tags.join(',')}
          >
            <ContentCard
              title={article.data.title}
              description={article.data.summary}
              url={article.data.url}
              tags={article.data.tags}
              author={article.data.author}
              type="article"
              date={new Date(article.data.publishDate).toLocaleDateString()}
            />
          </div>
        ))}
      </div>

      <div id="articles-list" class="hidden space-y-1">
        {articles.map((article) => (
          <div
            class="group flex items-center gap-3 rounded-lg px-3 py-2 transition-colors hover:bg-teal/5 dark:hover:bg-teal/10 cursor-pointer"
            data-sort-publish={new Date(article.data.publishDate).getTime()}
            data-sort-submitted={article.data.submittedDate ? new Date(article.data.submittedDate).getTime() : new Date(article.data.publishDate).getTime()}
            data-tags={article.data.tags.join(',')}
            data-flyout
            data-flyout-title={article.data.title}
            data-flyout-description={article.data.summary}
            data-flyout-url={article.data.url}
            data-flyout-type="article"
            data-flyout-date={new Date(article.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            data-flyout-author={article.data.author}
          >
            <span class="text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap w-24 shrink-0">
              {new Date(article.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            <span class="text-sm font-medium text-gray-900 dark:text-light group-hover:text-teal transition-colors truncate">
              {article.data.title}
            </span>
            <span class="ml-auto text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap shrink-0">
              {article.data.author}
            </span>
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-16 text-center">
        <p class="text-lg text-gray-500 dark:text-muted">No articles yet. Be the first to contribute!</p>
        <a href={`${base}contribute/`} class="mt-4 inline-flex items-center gap-2 rounded-lg bg-teal px-5 py-2.5 text-sm font-semibold text-darker transition-all duration-300 hover:bg-tealDark hover:shadow-[0_0_20px_rgba(0,212,170,0.2)]">
          Contribute an Article
        </a>
      </div>
    )}
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('articles-grid');
      const list = document.getElementById('articles-list');
      if (!grid || !list) return;

      // Sort both views
      document.addEventListener('sort-change', ((e: CustomEvent) => {
        const sortKey = e.detail.value;
        const attr = sortKey === 'submitted' ? 'data-sort-submitted' : 'data-sort-publish';
        [grid, list].forEach((container) => {
          const items = [...container.children] as HTMLElement[];
          items.sort((a, b) => Number(b.getAttribute(attr)) - Number(a.getAttribute(attr)));
          items.forEach((item) => container.appendChild(item));
        });
      }) as EventListener);
    });
  </script>
</BaseLayout>
