---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import JsonLd from '../components/JsonLd.astro';
import { getCollection } from 'astro:content';

// Fetch all collections
const allArticles = await getCollection('articles');
const allResources = await getCollection('resources');
const allVideos = await getCollection('videos');
const allEvents = await getCollection('events');
const allTools = await getCollection('tools');
const allLinkedin = await getCollection('linkedin');
const allLearnPaths = await getCollection('learn');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const learnPaths = allLearnPaths.sort((a, b) => {
  const order: Record<string, number> = { beginner: 0, intermediate: 1, advanced: 2 };
  return (order[a.data.difficulty] || 0) - (order[b.data.difficulty] || 0);
});

// Sort and take latest 3
const latestArticles = allArticles
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

const latestVideos = allVideos
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);

const latestEvents = allEvents
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const latestResources = allResources.slice(0, 3);
const latestTools = allTools.slice(0, 3);

const latestLinkedin = allLinkedin
  .sort((a, b) => new Date(b.data.submittedDate).getTime() - new Date(a.data.submittedDate).getTime())
  .slice(0, 3);

interface SectionItem {
  title: string;
  description: string;
  url: string;
  tags: string[];
  author?: string;
  date?: string;
}

function toSectionItems(
  items: { data: Record<string, any> }[],
  getDescription: (d: any) => string,
  getUrl: (d: any) => string,
  dateField?: string,
  authorField?: string,
): SectionItem[] {
  return items.map(item => ({
    title: item.data.title,
    description: getDescription(item.data),
    url: getUrl(item.data),
    tags: item.data.tags,
    author: authorField ? item.data[authorField] : undefined,
    date: dateField && item.data[dateField] ? new Date(item.data[dateField]).toISOString() : undefined,
  }));
}

const difficultyColors: Record<string, { bg: string; text: string }> = {
  beginner: { bg: 'bg-green-100 dark:bg-green-900/30', text: 'text-green-700 dark:text-green-400' },
  intermediate: { bg: 'bg-yellow-100 dark:bg-yellow-900/30', text: 'text-yellow-700 dark:text-yellow-400' },
  advanced: { bg: 'bg-red-100 dark:bg-red-900/30', text: 'text-red-700 dark:text-red-400' },
};

const siteUrl = Astro.site?.toString() || 'https://fabricdataagent.com';

const sections = [
  { key: 'articles', label: 'Articles', href: `${base}articles/`, items: toSectionItems(latestArticles, d => d.summary, d => d.url, 'publishDate', 'author'), type: 'article' as const },
  { key: 'videos', label: 'Videos', href: `${base}videos/`, items: toSectionItems(latestVideos, d => d.description, d => `https://www.youtube.com/watch?v=${d.youtubeId}`, 'publishDate', 'speaker'), type: 'video' as const },
  { key: 'events', label: 'Events', href: `${base}events/`, items: toSectionItems(latestEvents, d => d.description, d => d.url, 'date'), type: 'event' as const },
  { key: 'resources', label: 'Resources', href: `${base}resources/`, items: toSectionItems(latestResources, d => d.description, d => d.url, undefined, 'author'), type: 'resource' as const },
  { key: 'tools', label: 'Tools', href: `${base}tools/`, items: toSectionItems(latestTools, d => d.description, d => d.url, undefined, 'author'), type: 'tool' as const },
];
---

<BaseLayout title="Fabric Data Agent - Community Hub for Microsoft Fabric Data Agent">
  <JsonLd
    type="WebSite"
    title="Fabric Data Agent"
    description="Your community hub for Microsoft Fabric Data Agent resources"
    url={siteUrl}
  />

  <!-- ═══════════════════ HERO SECTION ═══════════════════ -->
  <section class="relative px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    <!-- Glowing orbs -->
    <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 -translate-x-1/2 -translate-y-1/2">
      <div class="h-[500px] w-[500px] rounded-full bg-teal/5 blur-[120px]"></div>
    </div>
    <div class="pointer-events-none absolute right-1/4 top-1/4 -z-10">
      <div class="h-[300px] w-[300px] rounded-full bg-indigo/10 blur-[100px]"></div>
    </div>
    <div class="pointer-events-none absolute bottom-0 left-1/4 -z-10">
      <div class="h-[200px] w-[200px] rounded-full bg-accent/5 blur-[80px]"></div>
    </div>

    <div class="relative mx-auto max-w-4xl text-center">
      <!-- Title -->
      <h1 class="bg-gradient-to-r from-teal via-navy to-teal dark:from-teal dark:via-indigo dark:to-teal bg-[length:200%_auto] bg-clip-text text-5xl font-extrabold tracking-tight text-transparent sm:text-6xl lg:text-7xl animate-gradient">
        Fabric Data Agent
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-xl font-medium text-gray-700 dark:text-light/90 sm:text-2xl">
        Your community hub for Microsoft Fabric Data Agent resources
      </p>

      <!-- Tagline -->
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-gray-500 dark:text-muted sm:text-lg">
        Discover articles, videos, tools, events, and resources - all curated by the community.
      </p>

      <!-- Search bar -->
      <div class="mx-auto mt-10 max-w-xl">
        <form action={`${base}search/`} method="get" class="group flex items-center gap-3 rounded-xl border border-gray-300 bg-white/60 dark:border-indigo/30 dark:bg-dark/60 px-5 py-4 shadow-sm dark:shadow-indigo/5 backdrop-blur-sm transition-all duration-300 hover:border-teal/40 hover:shadow-[0_0_30px_rgba(0,212,170,0.1)]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 dark:text-muted transition-colors group-hover:text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            name="q"
            placeholder="Search articles, videos, tools, events…"
            class="w-full bg-transparent text-gray-900 placeholder-gray-400 outline-none dark:text-light dark:placeholder-muted/60"
            autocomplete="off"
          />
        </form>
      </div>

      <!-- Decorative line -->
      <div class="mx-auto mt-8 flex items-center justify-center gap-2">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-teal/50"></div>
        <div class="h-1.5 w-1.5 rounded-full bg-teal shadow-[0_0_6px_rgba(0,212,170,0.6)]"></div>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-teal/50"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CHAT-STYLE EXPLAINER ═══════════════════ -->
  <section class="mx-auto max-w-3xl px-4 py-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-light mb-6 text-center">What is a Fabric Data Agent?</h2>

    <!-- Chat Window -->
    <div class="rounded-2xl border border-gray-200 dark:border-indigo/20 bg-white dark:bg-dark/60 shadow-lg overflow-hidden">

      <!-- Chat Header -->
      <div class="flex items-center gap-3 border-b border-gray-100 dark:border-indigo/10 px-5 py-3 bg-gray-50/80 dark:bg-dark/40">
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-teal/10">
          <svg class="h-4 w-4 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
          </svg>
        </div>
        <div>
          <div class="text-sm font-semibold text-gray-900 dark:text-light">Agent</div>
          <div class="text-xs text-teal">Online</div>
        </div>
      </div>

      <!-- Chat Messages (fixed-height, bottom-anchored) -->
      <div class="h-[300px] sm:h-[340px] overflow-y-auto scroll-smooth" id="chat-messages">
        <div class="flex min-h-full flex-col justify-end space-y-4 px-5 py-5" id="chat-messages-inner">

        <!-- User Q1 -->
        <div class="chat-msg flex justify-end">
          <div class="max-w-[80%] rounded-2xl rounded-br-md bg-gray-100 dark:bg-indigo/15 px-4 py-2.5 text-sm text-gray-800 dark:text-light/90">
            What is a Fabric Data Agent?
          </div>
        </div>

        <!-- Agent A1 -->
        <div class="chat-msg flex items-start gap-2.5">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal/10 mt-0.5">
            <svg class="h-3.5 w-3.5 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <div class="stream-text max-w-[80%] rounded-2xl rounded-bl-md border-l-2 border-teal/40 bg-gray-50 dark:bg-dark/40 px-4 py-2.5 text-sm text-gray-700 dark:text-muted">
            It's an AI-powered feature in Microsoft Fabric that lets anyone ask questions about their data in OneLake using plain English. It generates and runs queries for you automatically - no SQL, DAX, or KQL needed!
          </div>
        </div>

        <!-- User Q2 -->
        <div class="chat-msg flex justify-end">
          <div class="max-w-[80%] rounded-2xl rounded-br-md bg-gray-100 dark:bg-indigo/15 px-4 py-2.5 text-sm text-gray-800 dark:text-light/90">
            How is it different from Copilot?
          </div>
        </div>

        <!-- Agent A2 -->
        <div class="chat-msg flex items-start gap-2.5">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal/10 mt-0.5">
            <svg class="h-3.5 w-3.5 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <div class="stream-text max-w-[80%] rounded-2xl rounded-bl-md border-l-2 border-teal/40 bg-gray-50 dark:bg-dark/40 px-4 py-2.5 text-sm text-gray-700 dark:text-muted">
            Great question! A Data Agent is a standalone, customizable conversational AI system that supports many data sources in OneLake. As a domain expert, you configure it with the right business context, validate it, and integrate it with Microsoft Teams, Copilot Studio, or Foundry for use outside Fabric.
          </div>
        </div>

        <!-- User Q3 -->
        <div class="chat-msg flex justify-end">
          <div class="max-w-[80%] rounded-2xl rounded-br-md bg-gray-100 dark:bg-indigo/15 px-4 py-2.5 text-sm text-gray-800 dark:text-light/90">
            How do I get started?
          </div>
        </div>

        <!-- Agent A3 -->
        <div class="chat-msg flex items-start gap-2.5">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal/10 mt-0.5">
            <svg class="h-3.5 w-3.5 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <div class="stream-text max-w-[80%] rounded-2xl rounded-bl-md border-l-2 border-teal/40 bg-gray-50 dark:bg-dark/40 px-4 py-2.5 text-sm text-gray-700 dark:text-muted">
            Start with the <a href="https://learn.microsoft.com/en-us/fabric/data-science/concept-data-agent" target="_blank" rel="noopener" class="text-teal hover:text-tealDark font-medium">Microsoft Documentation</a> to understand the concepts, then check out our <a href={`${base}learn/get-started/`} class="text-teal hover:text-tealDark font-medium">Learning Paths</a> to go from zero to your first agent!
          </div>
        </div>

        <!-- User Q4 -->
        <div class="chat-msg flex justify-end">
          <div class="max-w-[80%] rounded-2xl rounded-br-md bg-gray-100 dark:bg-indigo/15 px-4 py-2.5 text-sm text-gray-800 dark:text-light/90">
            Sounds good, I want to build a Data Agent!
          </div>
        </div>

        <!-- Agent A4 -->
        <div class="chat-msg flex items-start gap-2.5">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal/10 mt-0.5">
            <svg class="h-3.5 w-3.5 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <div class="stream-text max-w-[80%] rounded-2xl rounded-bl-md border-l-2 border-teal/40 bg-gray-50 dark:bg-dark/40 px-4 py-2.5 text-sm text-gray-700 dark:text-muted">
            You're in the right place! Start with our <a href={`${base}learn/get-started/`} class="text-teal hover:text-tealDark font-medium">Beginner Learning Path</a> - it walks you through everything step by step, from setting up your workspace to asking your first question.
          </div>
        </div>

        </div>
      </div>

      <!-- Input Bar (decorative) -->
      <div class="border-t border-gray-100 dark:border-indigo/10 px-5 py-3 bg-gray-50/50 dark:bg-dark/30">
        <div class="flex items-center gap-3 rounded-xl border border-gray-200 dark:border-indigo/15 bg-white dark:bg-dark/40 px-4 py-2.5">
          <span class="text-sm text-gray-400 dark:text-muted/50 flex-1">Ask your question...</span>
          <svg class="h-5 w-5 text-teal/50" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.478 2.404a.75.75 0 00-.926.941l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.404z" />
          </svg>
        </div>
      </div>

    </div>
  </section>

  <style>
    .chat-msg {
      opacity: 0;
      transform: translateY(12px);
    }
    .chat-msg.chat-show {
      animation: chatFadeIn 0.4s ease-out forwards;
    }
    @keyframes chatFadeIn {
      to { opacity: 1; transform: translateY(0); }
    }
    .typing-dots {
      display: inline-flex;
      gap: 4px;
      align-items: center;
      height: 1.2em;
    }
    .typing-dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.3;
      animation: dotBounce 1.4s ease-in-out infinite;
    }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes dotBounce {
      0%, 80%, 100% { opacity: 0.2; transform: translateY(0); }
      40% { opacity: 0.6; transform: translateY(-4px); }
    }
    .stream-cursor {
      display: inline;
      font-weight: 400;
      opacity: 0.7;
      animation: cursorBlink 0.53s step-end infinite;
      color: var(--color-teal);
    }
    @keyframes cursorBlink {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .chat-msg {
        opacity: 1;
        transform: none;
      }
      .chat-msg.chat-show {
        animation: none;
      }
      .typing-dots span {
        animation: none;
      }
      .stream-cursor {
        animation: none;
      }
    }
  </style>

  <script>
    function initChatStream() {
      const container = document.getElementById('chat-messages');
      if (!container) return;

      const messages = Array.from(container.querySelectorAll('.chat-msg')) as HTMLElement[];
      if (messages.length === 0) return;

      // Reduced motion: show all messages immediately, skip animation
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        messages.forEach(msg => {
          msg.style.display = '';
          msg.style.opacity = '1';
          msg.style.transform = 'none';
        });
        container.scrollTop = container.scrollHeight;
        return;
      }

      // Auto-scroll container to bottom
      function scrollToBottom() {
        requestAnimationFrame(() => {
          container!.scrollTop = container!.scrollHeight;
        });
      }

      // Reset all messages - hide so they don't take up space
      messages.forEach(msg => {
        msg.classList.remove('chat-show');
        msg.style.display = 'none';
      });

      // Store original HTML for stream-text elements
      messages.forEach(msg => {
        const st = msg.querySelector('.stream-text');
        if (st) {
          if (!st.hasAttribute('data-original')) {
            st.setAttribute('data-original', st.innerHTML.trim());
          }
          st.innerHTML = '';
        }
      });

      let started = false;

      function showMessage(index: number) {
        if (index >= messages.length) return;

        const msg = messages[index];
        const streamEl = msg.querySelector('.stream-text') as HTMLElement | null;

        // Reveal and animate in
        msg.style.display = '';
        msg.classList.add('chat-show');

        // Scroll to keep latest message visible
        scrollToBottom();

        if (streamEl&& streamEl.hasAttribute('data-original')) {
          // Agent message: show typing dots, then stream text
          const el = streamEl;
          el.innerHTML = '<span class="typing-dots"><span></span><span></span><span></span></span>';

          msg.addEventListener('animationend', () => {
            setTimeout(() => {
              const html = el.getAttribute('data-original') || '';
              el.innerHTML = '';
              let i = 0;

              function typeChar() {
                if (i >= html.length) {
                  el.innerHTML = html;
                  setTimeout(() => showMessage(index + 1), 300);
                  return;
                }

                // Skip over HTML tags atomically
                if (html[i] === '<') {
                  const closeIdx = html.indexOf('>', i);
                  if (closeIdx !== -1) i = closeIdx + 1;
                  else i++;
                } else {
                  i++;
                }

                el.innerHTML = html.substring(0, i) + '<span class="stream-cursor">\u258C</span>';
                if (html[i - 1] === ' ') {
                  scrollToBottom();
                }
                const delay = html[i - 1] === ' ' ? 25 : 10;
                setTimeout(typeChar, delay);
              }

              typeChar();
            }, 300);
          }, { once: true });
        } else {
          // User message: fade in then show next
          msg.addEventListener('animationend', () => {
            setTimeout(() => showMessage(index + 1), 450);
          }, { once: true });
        }
      }

      // Trigger when chat section scrolls into view
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !started) {
            started = true;
            observer.disconnect();
            setTimeout(() => showMessage(0), 300);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(container);
    }

    // Run on initial load and after View Transitions
    initChatStream();
    document.addEventListener('astro:after-swap', initChatStream);
  </script>

  <!-- ═══════════════════ START HERE BANNER ═══════════════════ -->
  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <a href={`${base}learn/get-started/`} class="group block rounded-xl border border-teal/20 bg-teal/5 dark:bg-teal/5 p-6 transition-all duration-300 hover:border-teal/40 hover:shadow-[0_0_30px_rgba(0,212,170,0.1)]">
      <div class="flex items-center gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-teal/10 text-2xl">🚀</div>
        <div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-light group-hover:text-teal transition-colors">New here? Start with our Beginner Learning Path</h3>
          <p class="mt-1 text-sm text-gray-500 dark:text-muted">A guided path from zero to building your first Fabric Data Agent - articles, videos, and hands-on resources in the right order.</p>
        </div>
        <span class="hidden sm:block text-teal text-xl transition-transform group-hover:translate-x-1">→</span>
      </div>
    </a>
  </section>

  <!-- ═══════════════════ LEARNING PATHS ═══════════════════ -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8" id="learn">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">Learning Paths</h2>
      <a href={`${base}learn/`} class="group inline-flex items-center gap-1 text-sm font-medium text-teal transition-colors hover:text-tealDark">
        View all
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    {learnPaths.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {learnPaths.map((path) => {
          const c = difficultyColors[path.data.difficulty] || difficultyColors.beginner;
          return (
            <a href={`${base}learn/${path.id}/`} class="group rounded-xl border border-gray-200 bg-white/60 dark:border-indigo/20 dark:bg-dark/60 p-5 backdrop-blur-sm transition-all duration-300 hover:border-teal/30 hover:shadow-[0_0_20px_rgba(0,212,170,0.15)] hover:scale-[1.02] block">
              <div class="mb-3 flex items-center gap-2">
                <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${c.bg} ${c.text}`}>{path.data.difficulty}</span>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-light group-hover:text-teal transition-colors">{path.data.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-gray-500 dark:text-muted line-clamp-3">{path.data.description}</p>
              <div class="flex items-center gap-4 text-xs text-gray-400 dark:text-muted/60">
                <span class="inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                  {path.data.items.length} steps
                </span>
                {path.data.estimatedTime && (
                  <span class="inline-flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    {path.data.estimatedTime}
                  </span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-12 text-center">
        <p class="text-gray-500 dark:text-muted">No learning paths yet - <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 transition-colors hover:text-tealDark">be the first to contribute</a>!</p>
      </div>
    )}
  </section>

  <!-- ═══════════════════ CONTENT SECTIONS ═══════════════════ -->
  {sections.map(({ key, label, href, items, type }) => (
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8" id={key}>
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">{label}</h2>
        <a href={href} class="group inline-flex items-center gap-1 text-sm font-medium text-teal transition-colors hover:text-tealDark">
          View all
          <span class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>

      {items.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <ContentCard
              title={item.title}
              description={item.description}
              url={item.url}
              tags={item.tags}
              author={item.author}
              type={type}
              date={item.date}
            />
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-12 text-center">
          <p class="text-gray-500 dark:text-muted">No {label.toLowerCase()} yet - <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 transition-colors hover:text-tealDark">be the first to contribute</a>!</p>
        </div>
      )}
    </section>
  ))}

  <!-- ═══════════════════ LINKEDIN POSTS SECTION ═══════════════════ -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8" id="linkedin">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">LinkedIn Posts</h2>
      <a href={`${base}linkedin/`} class="group inline-flex items-center gap-1 text-sm font-medium text-teal transition-colors hover:text-tealDark">
        View all
        <span class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    {latestLinkedin.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latestLinkedin.map((post) => (
          <div
            class="group relative cursor-pointer rounded-xl border border-gray-200 bg-white/60 dark:border-indigo/20 dark:bg-dark/60 p-5 backdrop-blur-sm transition-all duration-300 hover:border-teal/30 hover:shadow-[0_0_20px_rgba(0,212,170,0.15)] hover:scale-[1.02]"
            data-tags={post.data.tags.join(',')}
            data-flyout
            data-flyout-title={post.data.title}
            data-flyout-description={post.data.description}
            data-flyout-url={post.data.linkedinUrl}
            data-flyout-type="linkedin"
            data-flyout-date={new Date(post.data.submittedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            data-flyout-author={post.data.author}
          >
            <div class="mb-3 flex items-center justify-between">
              <span class="inline-flex items-center gap-1 rounded-md bg-gray-100 dark:bg-indigo/20 px-2 py-1 text-xs font-medium text-gray-500 dark:text-muted">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                linkedin
              </span>
              <span class="text-xs text-gray-400 dark:text-muted/60">{new Date(post.data.submittedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <h3 class="mb-2 text-lg font-semibold leading-snug text-gray-900 dark:text-light transition-colors duration-300 group-hover:text-teal">
              {post.data.title}
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 inline-block h-3 w-3 text-gray-400 dark:text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </h3>
            <p class="mb-4 text-sm leading-relaxed text-gray-500 dark:text-muted line-clamp-3">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="mb-3 flex flex-wrap gap-1.5">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-teal/10 px-2.5 py-0.5 text-xs font-medium text-teal">{tag}</span>
                ))}
              </div>
            )}
            {post.data.author && (
              <div class="flex items-center gap-1.5 text-xs text-gray-400 dark:text-muted/60">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>Author: {post.data.author}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-xl border border-dashed border-gray-200 dark:border-indigo/20 py-12 text-center">
        <p class="text-gray-500 dark:text-muted">No linkedin posts yet - <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 transition-colors hover:text-tealDark">be the first to contribute</a>!</p>
      </div>
    )}
  </section>

  <!-- ═══════════════════ COMMUNITY CTA ═══════════════════ -->
  <section class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-100/60 via-white/80 to-gray-200/40 dark:border-indigo/20 dark:from-navy/60 dark:via-dark/80 dark:to-indigo/20 px-8 py-14 text-center backdrop-blur-sm sm:px-12">
      <!-- CTA glow -->
      <div class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2">
        <div class="h-32 w-64 rounded-full bg-teal/10 blur-3xl"></div>
      </div>

      <div class="relative">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-light sm:text-4xl">Join the Community</h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-gray-500 dark:text-muted sm:text-lg">
          This hub is built by the community, for the community. Anyone can contribute articles, videos, tools, and more by submitting a GitHub pull request.
        </p>
        <a
          href={`${base}contribute/`}
          class="mt-8 inline-flex items-center gap-2 rounded-lg bg-teal px-6 py-3 text-sm font-semibold text-darker transition-all duration-300 hover:bg-tealDark hover:shadow-[0_0_24px_rgba(0,212,170,0.3)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Contribute Now
        </a>
      </div>
    </div>
  </section>

  <style>
    @keyframes gradient-shift {
      0%, 100% { background-position: 0% center; }
      50% { background-position: 100% center; }
    }
    .animate-gradient {
      animation: gradient-shift 6s ease infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .animate-gradient {
        animation: none;
      }
    }
  </style>
</BaseLayout>
