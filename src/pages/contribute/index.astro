---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import JsonLd from '../../components/JsonLd.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Contribute | Fabric Data Agent" description="Help grow the Fabric Data Agent community by sharing resources">
  <JsonLd
    type="WebSite"
    title="Contribute"
    description="Help grow the Fabric Data Agent community by sharing resources"
    url="/contribute"
  />

  <PageHeader
    title="Contribute"
    description="Help grow the Fabric Data Agent community by sharing resources"
  />

  <section class="mx-auto max-w-4xl px-4 pb-20 sm:px-6 lg:px-8">

    <!-- Two Ways to Contribute -->
    <div class="mb-16">
      <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">Choose How to Contribute</h2>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <!-- Easy Way -->
        <div class="relative rounded-xl border-2 border-teal/40 bg-teal/5 dark:bg-teal/5 p-6">
          <span class="absolute -top-3 left-4 rounded-full bg-teal px-3 py-0.5 text-xs font-semibold text-darker">Recommended</span>
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-light">Submit via Form</h3>
          <p class="mb-4 text-sm leading-relaxed text-gray-500 dark:text-muted">
            Fill out a simple form on GitHub. No coding, no Git, no Markdown - just answer a few questions and submit. A maintainer will review and add your content.
          </p>
          <ul class="mb-6 space-y-2 text-sm text-gray-500 dark:text-muted">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> No technical knowledge needed</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> Takes about 2 minutes</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> Guided form fields with examples</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> Just need a free GitHub account</li>
          </ul>
          <a
            href="https://github.com/pawarbi/fabric-data-agent-website/issues/new/choose"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-teal px-5 py-2.5 text-sm font-semibold text-darker transition-all hover:bg-tealDark hover:shadow-lg"
          >
            Submit Content
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Developer Way -->
        <div class="rounded-xl border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 p-6">
          <h3 class="mb-3 text-xl font-bold text-gray-900 dark:text-light">Submit via Pull Request</h3>
          <p class="mb-4 text-sm leading-relaxed text-gray-500 dark:text-muted">
            For developers who prefer working directly with the codebase. Fork the repo, add a Markdown file, and open a PR.
          </p>
          <ul class="mb-6 space-y-2 text-sm text-gray-500 dark:text-muted">
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> Full control over the content file</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> Preview locally before submitting</li>
            <li class="flex items-start gap-2"><span class="mt-0.5 text-teal">&#10003;</span> Also for Learning Paths (complex format)</li>
          </ul>
          <a
            href="https://github.com/pawarbi/fabric-data-agent-website"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 dark:border-indigo/30 px-5 py-2.5 text-sm font-semibold text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal"
          >
            View Repository
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Submission Forms -->
    <div class="mb-16">
      <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">Submission Forms</h2>
      <p class="mb-6 text-gray-500 dark:text-muted">Pick the type of content you'd like to share. Each form will guide you through what's needed.</p>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues/new?template=article.yml" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 rounded-lg border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 px-4 py-3 text-sm font-medium text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal">
          <span class="text-lg">&#128196;</span> Article
        </a>
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues/new?template=video.yml" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 rounded-lg border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 px-4 py-3 text-sm font-medium text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal">
          <span class="text-lg">&#127909;</span> Video
        </a>
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues/new?template=resource.yml" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 rounded-lg border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 px-4 py-3 text-sm font-medium text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal">
          <span class="text-lg">&#128218;</span> Resource
        </a>
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues/new?template=event.yml" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 rounded-lg border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 px-4 py-3 text-sm font-medium text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal">
          <span class="text-lg">&#128197;</span> Event
        </a>
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues/new?template=tool.yml" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 rounded-lg border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 px-4 py-3 text-sm font-medium text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal">
          <span class="text-lg">&#128295;</span> Tool
        </a>
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues/new?template=linkedin.yml" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 rounded-lg border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60 px-4 py-3 text-sm font-medium text-gray-700 dark:text-muted transition-all hover:border-teal/30 hover:text-teal">
          <span class="text-lg">&#128279;</span> LinkedIn Post
        </a>
      </div>

      <p class="mt-4 text-xs text-gray-400 dark:text-muted/60">
        Learning Paths have a more complex format with ordered steps. Please use the <a href="https://github.com/pawarbi/fabric-data-agent-website" target="_blank" rel="noopener noreferrer" class="text-teal underline decoration-teal/40 hover:decoration-teal">Pull Request method</a> for Learning Paths.
      </p>
    </div>

    <!-- Fabric Jumpstart -->
    <div class="mb-16">
      <div class="rounded-xl border-2 border-teal/30 bg-teal/5 dark:bg-teal/5 p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-teal/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-light">Fabric Jumpstart</h3>
            <p class="mb-4 text-sm leading-relaxed text-gray-500 dark:text-muted">
              Create and submit a Fabric Jumpstart for Data Agent - a ready-to-run solution scenario that others can deploy in minutes. Fabric Jumpstart is an open-source platform for sharing curated, end-to-end demos and accelerators for Microsoft Fabric.
            </p>
            <a
              href="https://jumpstart.fabric.microsoft.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-teal px-5 py-2.5 text-sm font-semibold text-darker transition-all hover:bg-tealDark hover:shadow-lg"
            >
              Create a Jumpstart
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- What Happens Next -->
    <div class="mb-16">
      <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">What Happens After You Submit</h2>
      <div class="rounded-xl border border-gray-200 bg-gray-50/60 dark:border-white/10 dark:bg-darker/60 p-6 backdrop-blur-sm">
        <ol class="space-y-4 text-gray-500 dark:text-muted">
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-teal/20 text-xs font-bold text-teal">1</span>
            <span>Your submission appears as a GitHub Issue with the <code class="rounded bg-gray-200 dark:bg-dark px-1.5 py-0.5 text-xs">content-submission</code> label.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-teal/20 text-xs font-bold text-teal">2</span>
            <span>A maintainer reviews the submission for relevance and accuracy.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-teal/20 text-xs font-bold text-teal">3</span>
            <span>Once approved, the content is added to the site and the issue is closed with a link to the live page.</span>
          </li>
        </ol>
      </div>
    </div>

    <!-- Content Guidelines -->
    <div class="mb-16">
      <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">Content Guidelines</h2>
      <div class="rounded-xl border border-gray-200 bg-gray-50/60 dark:border-white/10 dark:bg-darker/60 p-6 backdrop-blur-sm">
        <ul class="space-y-3 text-gray-500 dark:text-muted">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-teal">&#10003;</span>
            <span>Content must be relevant to <span class="font-medium text-gray-900 dark:text-light">Microsoft Fabric Data Agents</span></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-teal">&#10003;</span>
            <span>Links must be accurate and functional</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-teal">&#10003;</span>
            <span>Write clear, informative descriptions (at least 2-3 sentences)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-teal">&#10003;</span>
            <span>Add relevant tags so others can discover your content</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-teal">&#10003;</span>
            <span>Only share content you have the right to share</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-teal">&#10003;</span>
            <span>Be respectful and inclusive</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Developer Reference (collapsible) -->
    <div class="mb-16">
      <details class="group rounded-xl border border-gray-200 dark:border-indigo/20 bg-white/60 dark:bg-dark/60">
        <summary class="cursor-pointer px-6 py-4 text-lg font-bold text-gray-900 dark:text-light hover:text-teal transition-colors">
          Developer Reference: Frontmatter Templates
          <span class="ml-2 text-sm font-normal text-gray-400 dark:text-muted">(click to expand)</span>
        </summary>
        <div class="border-t border-gray-200 dark:border-indigo/20 px-6 py-6">
          <p class="mb-6 text-sm text-gray-500 dark:text-muted">
            If you're contributing via Pull Request, add a Markdown file to the appropriate <code class="rounded bg-gray-200 dark:bg-dark px-1.5 py-0.5 text-xs">src/content/</code> directory with this frontmatter:
          </p>

          <div class="space-y-2 rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 font-mono text-sm mb-6">
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">Articles</span> &rarr; src/content/articles/your-article.md</div>
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">Resources</span> &rarr; src/content/resources/your-resource.md</div>
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">Videos</span> &rarr; src/content/videos/your-video.md</div>
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">Events</span> &rarr; src/content/events/your-event.md</div>
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">Tools</span> &rarr; src/content/tools/your-tool.md</div>
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">LinkedIn</span> &rarr; src/content/linkedin/your-post.md</div>
            <div class="text-gray-500 dark:text-muted"><span class="text-teal">Learn</span> &rarr; src/content/learn/your-learning-path.md</div>
          </div>

          <p class="mb-4 text-xs text-gray-400 dark:text-muted/60">Use kebab-case for filenames, e.g. <code class="rounded bg-gray-200 dark:bg-dark px-1 py-0.5 text-xs">my-article-title.md</code></p>

          <div class="space-y-6">
            <div>
              <h4 class="mb-2 font-semibold text-teal">Article</h4>
              <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 text-sm leading-relaxed text-gray-500 dark:text-muted"><code>---
title: "Article Title"
url: "https://example.com/article"
author: "Author Name"
publishDate: 2025-01-15
summary: "A brief summary of what this article covers..."
tags: ["data-agent", "fabric"]
contributor: "Your Name"
submittedDate: 2025-01-15
---</code></pre>
            </div>

            <div>
              <h4 class="mb-2 font-semibold text-teal">Video</h4>
              <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 text-sm leading-relaxed text-gray-500 dark:text-muted"><code>---
title: "Video Title"
youtubeId: "dQw4w9WgXcQ"
speaker: "Presenter Name"
publishDate: 2025-01-15
description: "What this video covers..."
tags: ["data-agent", "tutorial"]
contributor: "Your Name"
---</code></pre>
            </div>

            <div>
              <h4 class="mb-2 font-semibold text-teal">Resource</h4>
              <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 text-sm leading-relaxed text-gray-500 dark:text-muted"><code>---
title: "Resource Title"
url: "https://example.com/resource"
description: "A brief description..."
category: "documentation"
tags: ["data-agent", "fabric"]
contributor: "Your Name"
---</code></pre>
            </div>

            <div>
              <h4 class="mb-2 font-semibold text-teal">Event</h4>
              <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 text-sm leading-relaxed text-gray-500 dark:text-muted"><code>---
title: "Event Title"
url: "https://example.com/event"
date: 2025-03-20
location: "Virtual"
type: "conference"
description: "What this event is about..."
tags: ["conference", "fabric"]
contributor: "Your Name"
---</code></pre>
            </div>

            <div>
              <h4 class="mb-2 font-semibold text-teal">Tool</h4>
              <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 text-sm leading-relaxed text-gray-500 dark:text-muted"><code>---
title: "Tool Name"
url: "https://github.com/example/tool"
description: "What this tool does..."
category: "utility"
tags: ["data-agent", "utility"]
contributor: "Your Name"
---</code></pre>
            </div>

            <div>
              <h4 class="mb-2 font-semibold text-teal">LinkedIn Post</h4>
              <pre class="overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 dark:border-white/10 dark:bg-dark p-4 text-sm leading-relaxed text-gray-500 dark:text-muted"><code>---
title: "Post Title"
linkedinUrl: "https://www.linkedin.com/posts/..."
author: "Author Name"
description: "A brief description of the post..."
tags: ["data-agent", "fabric"]
contributor: "Your Name"
submittedDate: 2025-01-15
---</code></pre>
            </div>
          </div>
        </div>
      </details>
    </div>

    <!-- Questions -->
    <div class="text-center">
      <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-light sm:text-3xl">Questions?</h2>
      <p class="text-gray-500 dark:text-muted">
        Need help or have a suggestion? Open an issue on
        <a href="https://github.com/pawarbi/fabric-data-agent-website/issues" target="_blank" rel="noopener noreferrer" class="font-medium text-teal underline decoration-teal/40 transition hover:decoration-teal">GitHub</a>
        and we'll be happy to assist.
      </p>
    </div>

  </section>
</BaseLayout>
