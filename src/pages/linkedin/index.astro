---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagFilter from '../../components/TagFilter.astro';
import SortDropdown from '../../components/SortDropdown.astro';
import ViewToggle from '../../components/ViewToggle.astro';
import PageHeader from '../../components/PageHeader.astro';
import JsonLd from '../../components/JsonLd.astro';

const allPosts = await getCollection('linkedin');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.submittedDate).getTime() - new Date(a.data.submittedDate).getTime()
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

function extractLinkedInEmbed(url: string): { type: string; id: string } | null {
  const activityMatch = url.match(/activity[:\-](\d+)/);
  if (activityMatch) return { type: 'activity', id: activityMatch[1] };
  const ugcMatch = url.match(/ugcPost[:\-](\d+)/);
  if (ugcMatch) return { type: 'ugcPost', id: ugcMatch[1] };
  return null;
}
---

<BaseLayout title="LinkedIn Posts | Fabric Data Agent">
  <JsonLd
    type="CollectionPage"
    title="LinkedIn Posts | Fabric Data Agent"
    description="Community-shared LinkedIn posts about Microsoft Fabric Data Agents"
    url="/linkedin"
  />

  <PageHeader
    title="LinkedIn Posts"
    description="Community-shared LinkedIn posts about Microsoft Fabric Data Agents"
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-2">
      <div class="flex-1 min-w-0">{allTags.length > 0 && <TagFilter tags={allTags} />}</div>
      <div class="flex items-center gap-3">
        <SortDropdown
          options={[
            { value: 'submitted', label: 'Date Submitted' },
            { value: 'title', label: 'Title A–Z' },
          ]}
          defaultValue="submitted"
        />
        <ViewToggle gridId="linkedin-grid" listId="linkedin-list" />
      </div>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-gray-500 dark:text-muted text-lg">No LinkedIn posts available yet. Check back soon!</p>
        <p class="mt-2 text-sm text-gray-400 dark:text-muted/60">Have a post to share? <a href={`${base}contribute/`} class="text-teal underline decoration-teal/30 underline-offset-2 hover:text-tealDark">Contribute</a></p>
      </div>
    ) : (
      <div id="linkedin-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
        {posts.map((post) => {
          const embedInfo = extractLinkedInEmbed(post.data.linkedinUrl);
          const formattedDate = new Date(post.data.submittedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
          return (
            <div
              class="group rounded-2xl border border-gray-200 bg-white/60 dark:border-indigo/20 dark:bg-dark/50 backdrop-blur-sm overflow-hidden transition-all duration-300 hover:border-teal/40 hover:shadow-[0_0_20px_rgba(0,212,170,0.15)] hover:scale-[1.01]"
              data-tags={post.data.tags.join(',')}
              data-sort-submitted={new Date(post.data.submittedDate).getTime()}
              data-sort-title={post.data.title.toLowerCase()}
            >
              {/* LinkedIn Embed */}
              {embedInfo ? (
                <div class="w-full bg-gray-100 dark:bg-dark/30">
                  <iframe
                    src={`https://www.linkedin.com/embed/feed/update/urn:li:${embedInfo.type}:${embedInfo.id}`}
                    height="400"
                    width="100%"
                    frameborder="0"
                    allowfullscreen
                    title={`LinkedIn Post: ${post.data.title}`}
                    loading="lazy"
                    class="border-0"
                  />
                </div>
              ) : (
                <a
                  href={post.data.linkedinUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full bg-gradient-to-br from-[#0077B5] to-[#005582] p-6 text-white no-underline hover:from-[#0088cc] hover:to-[#006699] transition-all"
                >
                  <div class="flex items-center gap-3 mb-3">
                    <svg class="h-8 w-8 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                    <span class="text-sm font-medium opacity-90">LinkedIn Article</span>
                  </div>
                  <p class="text-lg font-semibold leading-snug line-clamp-2">{post.data.title}</p>
                  <span class="inline-flex items-center gap-1 mt-3 text-sm font-medium opacity-90 hover:opacity-100">
                    View on LinkedIn →
                  </span>
                </a>
              )}

              {/* Post Details */}
              <div
                class="p-6 space-y-3 cursor-pointer"
                data-flyout
                data-flyout-title={post.data.title}
                data-flyout-description={post.data.description}
                data-flyout-url={post.data.linkedinUrl}
                data-flyout-type="linkedin"
                data-flyout-date={formattedDate}
                data-flyout-contributor={post.data.contributor}
                data-flyout-linkedinactivityid={embedInfo ? `${embedInfo.type}:${embedInfo.id}` : ''}
                data-tags={post.data.tags.join(',')}
              >
                <h3 class="text-xl font-semibold text-gray-900 dark:text-light group-hover:text-teal transition-colors">
                  {post.data.title}
                </h3>

                <p class="text-sm text-teal font-medium flex items-center gap-1.5">
                  {/* LinkedIn icon */}
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                  {post.data.author}
                </p>

                <p class="text-gray-500 dark:text-muted text-sm leading-relaxed">{post.data.description}</p>

                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-1">
                    {post.data.tags.map((tag: string) => (
                      <span class="px-2.5 py-0.5 text-xs rounded-full bg-teal/10 font-medium text-teal">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex items-center justify-between pt-2 text-xs text-gray-400 dark:text-muted/60">
                  <span>{formattedDate}</span>
                  <span>Contributed by {post.data.contributor}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div id="linkedin-list" class="hidden space-y-1 mt-8">
        {posts.map((post) => {
          const formattedDate = new Date(post.data.submittedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          return (
            <div
              class="group flex items-center gap-3 rounded-lg px-3 py-2 transition-colors hover:bg-teal/5 dark:hover:bg-teal/10 cursor-pointer"
              data-sort-submitted={new Date(post.data.submittedDate).getTime()}
              data-sort-title={post.data.title.toLowerCase()}
              data-tags={post.data.tags.join(',')}
              data-flyout
              data-flyout-title={post.data.title}
              data-flyout-description={post.data.description}
              data-flyout-url={post.data.linkedinUrl}
              data-flyout-type="linkedin"
              data-flyout-date={formattedDate}
              data-flyout-author={post.data.author}
            >
              <span class="text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap w-24 shrink-0">
                {formattedDate}
              </span>
              <span class="text-sm font-medium text-gray-900 dark:text-light group-hover:text-teal transition-colors truncate">
                {post.data.title}
              </span>
              <span class="ml-auto text-xs text-gray-400 dark:text-muted/60 whitespace-nowrap shrink-0">
                {post.data.author}
              </span>
            </div>
          );
        })}
      </div>
    )}
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('linkedin-grid');
      const list = document.getElementById('linkedin-list');
      if (!grid || !list) return;

      document.addEventListener('sort-change', ((e: CustomEvent) => {
        const sortKey = e.detail.value;
        [grid, list].forEach((container) => {
          const items = [...container.children] as HTMLElement[];
          if (sortKey === 'title') {
            items.sort((a, b) => (a.getAttribute('data-sort-title') || '').localeCompare(b.getAttribute('data-sort-title') || ''));
          } else {
            items.sort((a, b) => Number(b.getAttribute('data-sort-submitted')) - Number(a.getAttribute('data-sort-submitted')));
          }
          items.forEach((item) => container.appendChild(item));
        });
      }) as EventListener);
    });
  </script>
</BaseLayout>
