---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Page Not Found | Fabric Data Agent">
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-6 py-16 text-center">
    <div class="mb-6 text-8xl font-bold text-teal/30">404</div>
    <h1 class="mb-3 text-3xl font-bold text-gray-900 dark:text-light">Page not found</h1>
    <p class="mb-8 max-w-md text-gray-500 dark:text-muted">
      The page you're looking for doesn't exist or has been moved.
      Try searching or browse the categories below.
    </p>

    <!-- Search -->
    <div class="mb-8 w-full max-w-md">
      <form action={`${base}search/`} method="get" class="relative">
        <input
          type="text"
          name="q"
          placeholder="Search for articles, videos, tools..."
          class="w-full rounded-xl border border-gray-200 bg-white/80 px-5 py-3 pl-12 text-sm text-gray-900 shadow-sm backdrop-blur-sm transition-colors placeholder:text-gray-400 focus:border-teal focus:outline-none focus:ring-2 focus:ring-teal/20 dark:border-indigo/20 dark:bg-dark/60 dark:text-light dark:placeholder:text-muted/60"
        />
        <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400 dark:text-muted/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </form>
    </div>

    <!-- Quick links -->
    <div class="flex flex-wrap justify-center gap-3">
      {[
        { label: 'Home', href: `${base}` },
        { label: 'Articles', href: `${base}articles/` },
        { label: 'Videos', href: `${base}videos/` },
        { label: 'Resources', href: `${base}resources/` },
        { label: 'Tools', href: `${base}tools/` },
        { label: 'Events', href: `${base}events/` },
        { label: 'LinkedIn', href: `${base}linkedin/` },
      ].map(link => (
        <a
          href={link.href}
          class="rounded-lg border border-gray-200 bg-white/60 px-4 py-2 text-sm font-medium text-gray-700 transition-all hover:border-teal/40 hover:text-teal dark:border-indigo/20 dark:bg-dark/50 dark:text-muted dark:hover:text-teal"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
