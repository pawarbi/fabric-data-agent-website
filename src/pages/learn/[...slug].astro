---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const paths = await getCollection('learn');
  return paths.map(path => ({
    params: { slug: path.id },
    props: { path },
  }));
}

const { path } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content } = await render(path);

const difficultyStyles: Record<string, { bg: string; text: string; label: string }> = {
  beginner: { bg: 'bg-teal/15', text: 'text-teal', label: '🌱 Beginner' },
  intermediate: { bg: 'bg-amber-500/15', text: 'text-amber-400', label: '⚡ Intermediate' },
  advanced: { bg: 'bg-accent/15', text: 'text-accent', label: '🔥 Advanced' },
};

const typeConfig: Record<string, { icon: string; label: string }> = {
  article: { icon: '📄', label: 'Article' },
  video: { icon: '🎬', label: 'Video' },
  resource: { icon: '📚', label: 'Resource' },
  tool: { icon: '🔧', label: 'Tool' },
  external: { icon: '🔗', label: 'External' },
};

const style = difficultyStyles[path.data.difficulty];
const isExternal = (url: string) => url.startsWith('http');
---

<BaseLayout title={`${path.data.title} | Fabric Data Agent`} description={path.data.description}>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    {/* Back link */}
    <a href={`${base}learn/`} class="mb-8 inline-flex items-center gap-2 text-sm text-gray-500 dark:text-muted transition-colors hover:text-teal">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Learning Paths
    </a>

    {/* Header */}
    <div class="mb-10">
      <h1 class="mb-4 bg-gradient-to-r from-teal via-gray-900 to-teal dark:via-light bg-clip-text text-3xl font-extrabold tracking-tight text-transparent sm:text-4xl">
        {path.data.title}
      </h1>

      <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${style.bg} ${style.text}`}>
          {style.label}
        </span>
        {path.data.estimatedTime && (
          <span class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {path.data.estimatedTime}
          </span>
        )}
        <span class="text-sm text-gray-500 dark:text-muted">•</span>
        <span class="text-sm text-gray-500 dark:text-muted">{path.data.items.length} steps</span>
      </div>

      <p class="text-base leading-relaxed text-gray-500 dark:text-muted">{path.data.description}</p>

      {path.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {path.data.tags.map((tag) => (
            <span class="rounded-full bg-teal/10 px-2.5 py-0.5 text-xs font-medium text-teal">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    {/* Progress bar */}
    <div class="mb-8" data-path-id={path.id}>
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-gray-500 dark:text-muted">Progress</span>
        <span id="path-progress-text" class="text-sm text-teal font-medium">0/{path.data.items.length} completed</span>
      </div>
      <div class="h-2 rounded-full bg-gray-200 dark:bg-indigo/20 overflow-hidden">
        <div id="path-progress-bar" class="h-full rounded-full bg-teal transition-all duration-500" style="width: 0%"></div>
      </div>
    </div>

    {/* Timeline */}
    <div class="relative">
      {path.data.items.map((item, index) => {
        const type = typeConfig[item.type] || typeConfig.external;
        const last = index === path.data.items.length - 1;
        return (
          <div class="relative flex gap-6 pb-10">
            {/* Connector line */}
            {!last && (
              <div class="absolute left-5 top-12 h-[calc(100%-2rem)] w-px bg-gradient-to-b from-teal/40 to-indigo/20"></div>
            )}

            {/* Step number circle */}
            <div class="relative z-10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border-2 border-teal bg-white dark:bg-darker text-sm font-bold text-teal shadow-[0_0_12px_rgba(0,212,170,0.3)] step-circle" data-step-index={index}>
              {index + 1}
            </div>

            {/* Content */}
            <div class="flex-1 rounded-xl border border-gray-200 bg-white/60 dark:border-indigo/20 dark:bg-dark/60 p-5 backdrop-blur-sm transition-all duration-300 hover:border-teal/30 hover:shadow-[0_0_20px_rgba(0,212,170,0.1)]">
              <div class="mb-2 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 rounded-md bg-gray-100 dark:bg-indigo/20 px-2 py-0.5 text-xs font-medium text-gray-500 dark:text-muted">
                    <span>{type.icon}</span>
                    {type.label}
                  </span>
                </div>
                <label class="flex items-center gap-2 cursor-pointer text-sm text-gray-500 dark:text-muted">
                  <input type="checkbox" class="path-step-checkbox accent-teal h-4 w-4 rounded"
                    data-path-id={path.id}
                    data-step-index={index}
                  />
                  <span class="step-label text-xs">Done</span>
                </label>
              </div>

              <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-light">
                {item.url ? (
                  <a
                    href={item.url}
                    target={isExternal(item.url) ? '_blank' : undefined}
                    rel={isExternal(item.url) ? 'noopener noreferrer' : undefined}
                    class="transition-colors hover:text-teal"
                  >
                    {item.title}
                    {isExternal(item.url) && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 inline-block h-3.5 w-3.5 text-gray-400 dark:text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    )}
                  </a>
                ) : (
                  item.title
                )}
              </h3>

              <p class="text-sm leading-relaxed text-gray-500 dark:text-muted">{item.description}</p>
            </div>
          </div>
        );
      })}
    </div>

    {/* Markdown body content */}
    <div class="mt-8 rounded-xl border border-gray-200 bg-white/60 dark:border-indigo/20 dark:bg-dark/60 p-6 backdrop-blur-sm prose prose-sm dark:prose-invert max-w-none prose-headings:text-gray-900 dark:prose-headings:text-light prose-p:text-gray-500 dark:prose-p:text-muted prose-a:text-teal">
      <Content />
    </div>

    {/* Contributor */}
    {path.data.contributor && (
      <div class="mt-8 flex items-center gap-2 text-sm text-gray-400 dark:text-muted/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>Curated by {path.data.contributor}</span>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  function getPathProgress(pathId: string): number[] {
    try {
      return JSON.parse(localStorage.getItem(`fda-path-${pathId}`) || '[]');
    } catch { return []; }
  }

  function togglePathStep(checkbox: HTMLInputElement) {
    const pathId = checkbox.dataset.pathId!;
    const stepIndex = parseInt(checkbox.dataset.stepIndex!);
    const progress = getPathProgress(pathId);

    if (progress.includes(stepIndex)) {
      progress.splice(progress.indexOf(stepIndex), 1);
    } else {
      progress.push(stepIndex);
    }

    localStorage.setItem(`fda-path-${pathId}`, JSON.stringify(progress));
    updatePathProgress(pathId);
  }

  function updatePathProgress(pathId: string) {
    const progress = getPathProgress(pathId);
    document.querySelectorAll<HTMLInputElement>(`.path-step-checkbox[data-path-id="${pathId}"]`).forEach(cb => {
      const idx = parseInt(cb.dataset.stepIndex!);
      cb.checked = progress.includes(idx);
      // Style the step circle for completed steps
      const stepRow = cb.closest('.relative.flex.gap-6');
      const circle = stepRow?.querySelector('.step-circle') as HTMLElement | null;
      if (circle) {
        if (progress.includes(idx)) {
          circle.classList.add('bg-teal', 'text-white', 'border-teal');
          circle.classList.remove('dark:bg-darker', 'bg-white');
          circle.innerHTML = '✓';
        } else {
          circle.classList.remove('bg-teal', 'text-white');
          circle.classList.add('dark:bg-darker', 'bg-white', 'border-teal');
          circle.innerHTML = String(idx + 1);
        }
      }
    });

    const totalSteps = document.querySelectorAll(`.path-step-checkbox[data-path-id="${pathId}"]`).length;
    const progressBar = document.getElementById('path-progress-bar');
    if (progressBar) {
      const pct = totalSteps > 0 ? (progress.length / totalSteps * 100) : 0;
      progressBar.style.width = `${pct}%`;
    }
    const progressText = document.getElementById('path-progress-text');
    if (progressText) {
      progressText.textContent = `${progress.length}/${totalSteps} completed`;
    }
  }

  function initPathProgress() {
    // Attach event listeners
    document.querySelectorAll<HTMLInputElement>('.path-step-checkbox').forEach(cb => {
      cb.addEventListener('change', () => togglePathStep(cb));
    });
    // Restore state
    const pathContainer = document.querySelector('[data-path-id]') as HTMLElement | null;
    if (pathContainer) {
      updatePathProgress(pathContainer.dataset.pathId!);
    }
  }

  document.addEventListener('DOMContentLoaded', initPathProgress);
  document.addEventListener('astro:after-swap', initPathProgress);
</script>
